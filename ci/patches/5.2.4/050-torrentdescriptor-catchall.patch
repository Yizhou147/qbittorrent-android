+// Android: libtorrent 抛出的 boost/system 异常在跨 DSO (libtorrent-rasterbar.so ->
+// libqbt.so) 时可能匹配不上上面这个 catch (异常类型身份不一致), 逃出 noexcept 函数
+// 会被 std::terminate 直接 abort (表现为"添加种子即闪退")。catch (...) 不依赖类型匹配,
+// 因此这里再兜一层, 保证任何异常都退化成"返回错误信息"而不是崩溃。
+catch (const std::exception &err)
+{
+    return nonstd::make_unexpected(QString::fromLocal8Bit(err.what()));
+}
+catch (...)
+{
+    return nonstd::make_unexpected(u"Unknown error"_s);
+}
 
